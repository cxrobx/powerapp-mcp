{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Power Apps Control Definition Schema",
  "description": "Complete JSON schema for Power Apps .msapp control definitions",
  "definitions": {
    "ControlInfo": {
      "type": "object",
      "required": ["Type", "Name", "Template", "Rules", "Children"],
      "properties": {
        "Type": {
          "type": "string",
          "enum": ["ControlInfo"],
          "description": "Always 'ControlInfo' for control definitions"
        },
        "Name": {
          "type": "string",
          "description": "Unique control name within parent context"
        },
        "HasDynamicProperties": {
          "type": "boolean",
          "description": "Control has computed/dynamic properties"
        },
        "Template": {
          "$ref": "#/definitions/Template",
          "description": "Template definition and metadata"
        },
        "Index": {
          "type": "number",
          "description": "Z-order index (float value)"
        },
        "PublishOrderIndex": {
          "type": "integer",
          "description": "Execution order during publishing"
        },
        "VariantName": {
          "type": "string",
          "description": "Design variant name if applicable"
        },
        "LayoutName": {
          "type": "string",
          "description": "Layout variant name"
        },
        "MetaDataIDKey": {
          "type": "string",
          "description": "Metadata reference identifier"
        },
        "PersistMetaDataIDKey": {
          "type": "boolean",
          "description": "Persist metadata ID flag"
        },
        "IsFromScreenLayout": {
          "type": "boolean",
          "description": "Control generated from screen layout"
        },
        "StyleName": {
          "type": "string",
          "description": "Applied style name"
        },
        "Parent": {
          "type": "string",
          "description": "Parent control name"
        },
        "IsDataControl": {
          "type": "boolean",
          "description": "Can access data sources"
        },
        "AllowAccessToGlobals": {
          "type": "boolean",
          "description": "Can access global variables"
        },
        "IsGroupControl": {
          "type": "boolean",
          "description": "Is a group/container control"
        },
        "IsAutoGenerated": {
          "type": "boolean",
          "description": "Auto-generated (e.g., by form or gallery)"
        },
        "Rules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Rule"
          },
          "description": "Property definitions and values"
        },
        "ControlPropertyState": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "#/definitions/PropertyState" }
            ]
          },
          "description": "Tracks which properties are explicitly set"
        },
        "IsLocked": {
          "type": "boolean",
          "description": "Locked in editor"
        },
        "ControlUniqueId": {
          "type": "string",
          "description": "Unique numeric ID"
        },
        "Children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ControlInfo"
          },
          "description": "Child controls"
        }
      }
    },
    "Template": {
      "type": "object",
      "required": ["Id", "Version", "Name", "FirstParty"],
      "properties": {
        "Id": {
          "type": "string",
          "description": "Template URI (e.g., 'http://microsoft.com/appmagic/button')"
        },
        "Version": {
          "type": "string",
          "description": "Template version (e.g., '2.2.0' or timestamp)"
        },
        "LastModifiedTimestamp": {
          "type": "string",
          "description": "Last modification timestamp"
        },
        "Name": {
          "type": "string",
          "description": "Template name (e.g., 'button', 'label', 'screen')"
        },
        "FirstParty": {
          "type": "boolean",
          "description": "Microsoft provided template"
        },
        "IsPremiumPcfControl": {
          "type": "boolean",
          "description": "Premium Power Component Framework control"
        },
        "IsCustomGroupControlTemplate": {
          "type": "boolean",
          "description": "Custom group control template"
        },
        "CustomGroupControlTemplateName": {
          "type": "string",
          "description": "Name of custom group template"
        },
        "IsComponentDefinition": {
          "type": "boolean",
          "description": "Is a component definition"
        },
        "ComponentType": {
          "type": "string",
          "enum": ["CanvasComponent"],
          "description": "Component type if IsComponentDefinition is true"
        },
        "HostType": {
          "type": "string",
          "description": "Host control type (e.g., 'Default')"
        },
        "OverridableProperties": {
          "type": "object",
          "description": "Properties that can be overridden"
        }
      }
    },
    "Rule": {
      "type": "object",
      "required": ["Property", "Category", "InvariantScript", "RuleProviderType"],
      "properties": {
        "Property": {
          "type": "string",
          "description": "Property name (e.g., 'Text', 'Fill', 'OnSelect')"
        },
        "Category": {
          "type": "string",
          "enum": ["Data", "Design", "Behavior", "ConstantData"],
          "description": "Property category"
        },
        "InvariantScript": {
          "type": "string",
          "description": "PowerFx formula or constant value"
        },
        "RuleProviderType": {
          "type": "string",
          "enum": ["Unknown", "System", "User"],
          "description": "Who provided this rule"
        }
      }
    },
    "PropertyState": {
      "type": "object",
      "properties": {
        "InvariantPropertyName": {
          "type": "string",
          "description": "Property name"
        },
        "AutoRuleBindingEnabled": {
          "type": "boolean",
          "description": "Auto data binding enabled"
        },
        "AutoRuleBindingString": {
          "type": "string",
          "description": "Default binding formula"
        },
        "NameMapSourceSchema": {
          "type": "string",
          "description": "Schema mapping reference"
        },
        "IsLockable": {
          "type": "boolean",
          "description": "Can be locked in editor"
        },
        "AFDDataSourceName": {
          "type": "string",
          "description": "App-From-Data source name"
        }
      }
    },
    "ControlRoot": {
      "type": "object",
      "required": ["TopParent"],
      "properties": {
        "TopParent": {
          "$ref": "#/definitions/ControlInfo",
          "description": "Root control (App, Screen, or Component)"
        }
      }
    }
  },
  "properties": {
    "TopParent": {
      "$ref": "#/definitions/ControlInfo"
    }
  },
  "examples": [
    {
      "description": "Button Control Example",
      "value": {
        "TopParent": {
          "Type": "ControlInfo",
          "Name": "Button1",
          "Template": {
            "Id": "http://microsoft.com/appmagic/button",
            "Version": "2.2.0",
            "Name": "button",
            "FirstParty": true,
            "IsPremiumPcfControl": false,
            "IsComponentDefinition": false,
            "OverridableProperties": {}
          },
          "Index": 0.0,
          "PublishOrderIndex": 290,
          "Parent": "EditScreen1",
          "IsDataControl": false,
          "AllowAccessToGlobals": true,
          "IsGroupControl": false,
          "IsAutoGenerated": false,
          "Rules": [
            {
              "Property": "Text",
              "Category": "Data",
              "InvariantScript": "\"Submit\"",
              "RuleProviderType": "Unknown"
            },
            {
              "Property": "OnSelect",
              "Category": "Behavior",
              "InvariantScript": "SubmitForm(EditForm1)",
              "RuleProviderType": "Unknown"
            },
            {
              "Property": "Fill",
              "Category": "Design",
              "InvariantScript": "RGBA(56, 96, 178, 1)",
              "RuleProviderType": "Unknown"
            },
            {
              "Property": "X",
              "Category": "Design",
              "InvariantScript": "1021",
              "RuleProviderType": "Unknown"
            },
            {
              "Property": "Y",
              "Category": "Design",
              "InvariantScript": "15",
              "RuleProviderType": "Unknown"
            },
            {
              "Property": "Width",
              "Category": "Design",
              "InvariantScript": "90",
              "RuleProviderType": "Unknown"
            },
            {
              "Property": "Height",
              "Category": "Design",
              "InvariantScript": "31",
              "RuleProviderType": "Unknown"
            }
          ],
          "ControlPropertyState": [
            "Text",
            "OnSelect",
            "Fill",
            "X",
            "Y",
            "Width",
            "Height"
          ],
          "IsLocked": false,
          "ControlUniqueId": "123",
          "Children": []
        }
      }
    },
    {
      "description": "Screen with Form Example",
      "value": {
        "TopParent": {
          "Type": "ControlInfo",
          "Name": "EditScreen1",
          "Template": {
            "Id": "http://microsoft.com/appmagic/screen",
            "Version": "1.0",
            "Name": "screen",
            "FirstParty": true,
            "IsComponentDefinition": false,
            "OverridableProperties": {}
          },
          "IsDataControl": true,
          "AllowAccessToGlobals": true,
          "Rules": [
            {
              "Property": "Fill",
              "Category": "Design",
              "InvariantScript": "RGBA(255, 255, 255, 1)",
              "RuleProviderType": "Unknown"
            }
          ],
          "ControlPropertyState": ["Fill"],
          "IsLocked": false,
          "ControlUniqueId": "114",
          "Children": [
            {
              "Type": "ControlInfo",
              "Name": "EditForm1",
              "Template": {
                "Id": "http://microsoft.com/appmagic/form",
                "Version": "2.4.0",
                "Name": "form",
                "FirstParty": true,
                "IsComponentDefinition": false,
                "OverridableProperties": {}
              },
              "Parent": "EditScreen1",
              "Rules": [
                {
                  "Property": "DataSource",
                  "Category": "Data",
                  "InvariantScript": "[@'Task Tracker']",
                  "RuleProviderType": "Unknown"
                },
                {
                  "Property": "DefaultMode",
                  "Category": "Data",
                  "InvariantScript": "FormMode.New",
                  "RuleProviderType": "Unknown"
                },
                {
                  "Property": "NumberOfColumns",
                  "Category": "Design",
                  "InvariantScript": "3",
                  "RuleProviderType": "Unknown"
                }
              ],
              "ControlPropertyState": ["DataSource", "DefaultMode", "NumberOfColumns"],
              "IsLocked": false,
              "ControlUniqueId": "115",
              "Children": [
                {
                  "Type": "ControlInfo",
                  "Name": "Priority_DataCard",
                  "Template": {
                    "Id": "http://microsoft.com/appmagic/card",
                    "Version": "1.0.5",
                    "Name": "typedDataCard",
                    "FirstParty": true,
                    "IsComponentDefinition": false,
                    "OverridableProperties": {}
                  },
                  "Parent": "EditForm1",
                  "Rules": [
                    {
                      "Property": "DataField",
                      "Category": "Data",
                      "InvariantScript": "\"Priority\"",
                      "RuleProviderType": "Unknown"
                    },
                    {
                      "Property": "DisplayName",
                      "Category": "Data",
                      "InvariantScript": "\"Priority\"",
                      "RuleProviderType": "Unknown"
                    }
                  ],
                  "ControlPropertyState": ["DataField", "DisplayName"],
                  "IsLocked": false,
                  "ControlUniqueId": "116",
                  "Children": [
                    {
                      "Type": "ControlInfo",
                      "Name": "DataCardValue",
                      "Template": {
                        "Id": "http://microsoft.com/appmagic/combobox",
                        "Version": "2.4.0",
                        "Name": "combobox",
                        "FirstParty": true,
                        "IsComponentDefinition": false,
                        "OverridableProperties": {}
                      },
                      "Parent": "Priority_DataCard",
                      "Rules": [
                        {
                          "Property": "Items",
                          "Category": "Data",
                          "InvariantScript": "[\"Beginner\", \"Intermediate\", \"Advanced\"]",
                          "RuleProviderType": "Unknown"
                        }
                      ],
                      "ControlPropertyState": ["Items"],
                      "IsLocked": false,
                      "ControlUniqueId": "117",
                      "Children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ]
}
